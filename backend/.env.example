# Copy this file to .env and fill in real values. Never commit .env.

# From Stripe Dashboard > Developers > API keys (use test keys first, sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# From Stripe Dashboard > Product catalog > your $9/month Price (starts price_...)
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# From Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Your live homepage URL (used for redirects and CORS)
FRONTEND_URL=https://your-jaguar-domain.com

PORT=4242
